{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RestedRealm Companion",
  "mainBinaryName": "RestedRealm Companion",
  "identifier": "com.restedrealm.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RestedRealm Companion",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "backgroundColor": "#111512"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "restedrealm-companion"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "RestedRealm",
    "homepage": "https://restedrealm.com",
    "copyright": "Copyright (c) 2026 Reinier Ham. MIT License.",
    "shortDescription": "Uploads your RestedRealm addon data to restedrealm.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../addon/RestedRealmCollector/": "addon/RestedRealmCollector/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "longDescription": "Imports the RestedRealm addon's saves from World of Warcraft: Forever and uploads them to your RestedRealm account."
  }
}
